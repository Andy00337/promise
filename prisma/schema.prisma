generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model QrCode {
  id          String    @id @default(uuid())
  token       String    @unique
  blessing    String
  wxLink      String
  status      String    @default("unused")
  scannedAt   DateTime?
  latitude    Float?
  longitude   Float?
  ipAddress   String?
  createdAt   DateTime  @default(now())
}
